        <!-- ==================== HEADER TITLE ==================== -->
        <mxCell id="mainTitle" value="&lt;b style='font-size:20px;color:#0D47A1;'&gt;🧠 XFSCI: AI AGENT INTERNAL ARCHITECTURE DEEP DIVE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#455A64;'&gt;Arsitektur Lengkap Otak AI Agent Hybrid dengan Mekanisme Reinforcement Learning (RL)  —  Gemini 2.0 Flash · Pandas · RAG · Guardrails · Experience Memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;align=center;verticalAlign=middle;arcSize=6;shadow=1;" vertex="1" parent="1">
