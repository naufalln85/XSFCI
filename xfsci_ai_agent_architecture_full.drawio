        <mxCell id="inPerception" value="&lt;b&gt;🧠 AI Perception Feed (GNN + LSTM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Root-Cause: payment-service | Risk: 0.89 | Blast Radius: [order]&lt;br&gt;FL-LSTM: Prediksi OOM dalam 420 detik&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E35B1;strokeColor=#4527A0;strokeWidth=1.5;fontSize=10;fontColor=#FFF;arcSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="225" width="330" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="inK8s" value="&lt;b&gt;☸️ Kubernetes Cluster State &amp; Limits&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Node Capacity, Available RAM/CPU, Max Replicas: 10, Cooldown Status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#0D47A1;strokeWidth=1.5;fontSize=10;fontColor=#FFF;arcSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="305" width="330" height="60" as="geometry"/>
        </mxCell>

        <!-- Core Component: Pandas Engine -->
        <mxCell id="compPandas" value="&lt;b style='font-size:13px'&gt;🐼 PANDAS STATE ENGINE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Representasi Eksak STATE (sₜ) dalam RL&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Parsing PromQL ke Matrix DataFrame&lt;br&gt;• Kalkulasi Aritmatika 100% Deterministik&lt;br&gt;• Delta RAM Growth Rate (+12.4 MiB/min)&lt;br&gt;• Statistical Moving Average &amp; Percentile&lt;br&gt;&lt;i style='color:#C8E6C9'&gt;Anti-Halusinasi Angka Matematika LLM&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=2.5;fontSize=11;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="395" width="330" height="150" as="geometry"/>
        </mxCell>

        <!-- Component: Deterministic Scoring Engine -->
        <mxCell id="compScoring" value="&lt;b style='font-size:13px'&gt;📐 DETERMINISTIC URGENCY SCORER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Estimasi Reward Awal / Value Function&lt;/b&gt;&lt;br&gt;&lt;br&gt;Formula Matematis Auditable:&lt;br&gt;&lt;code&gt;Score = w₁·RAM_pct + w₂·Latency_delta + w₃·Error&lt;/code&gt;&lt;br&gt;Output: &lt;b&gt;88 / 100 (CRITICAL)&lt;/b&gt;&lt;br&gt;Menentukan prioritas eksekusi tanpa black-box&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="575" width="330" height="135" as="geometry"/>
        </mxCell>

        <!-- State Payload Assembler -->
        <mxCell id="compPayload" value="&lt;b style='font-size:12px'&gt;📋 State Payload Serializer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Menyatukan State Matrix, Risk Score &amp; Node Constraints&lt;br&gt;menjadi objek Python Dict terstandarisasi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474F;strokeColor=#263238;strokeWidth=1.5;fontSize=10;fontColor=#FFFFFF;arcSize=10;shadow=1;" vertex="1" parent="1">
