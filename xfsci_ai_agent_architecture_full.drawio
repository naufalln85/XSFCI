        <mxCell id="inProm" value="&lt;b&gt;📊 Prometheus PromQL Stream&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;CPU, RAM, RPS, P95 Latency, Error Rate, Restarts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00897B;strokeColor=#004D40;strokeWidth=1.5;fontSize=10;fontColor=#FFF;arcSize=10;shadow=1;" vertex="1" parent="1">
