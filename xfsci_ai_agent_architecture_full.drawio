        <mxCell id="ea5" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#37474F;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="compScoring" target="compPayload"><mxGeometry relative="1" as="geometry"/></mxCell>


        <!-- ==================== ZONE B: KNOWLEDGE & REPLAY MEMORY ==================== -->
        <mxCell id="zoneBBg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=2;opacity=40;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="450" y="105" width="370" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="zoneBLabel" value="&lt;b style='font-size:13px;color:#1A237E;'&gt;ZONE B: KNOWLEDGE &amp; EPISODIC MEMORY&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="465" y="115" width="340" height="25" as="geometry"/>
        </mxCell>

        <!-- RAG ChromaDB SOP -->
        <mxCell id="compRAG" value="&lt;b style='font-size:13px'&gt;📚 RAG SOP KNOWLEDGE BASE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Basis Pengetahuan Terstruktur (Policy Prior)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Vector Store (ChromaDB)&lt;/b&gt; menyimpan 6 SOP:&lt;br&gt;• SOP-01: Pod CrashLoopBackOff Remediation&lt;br&gt;• SOP-02: Sudden Spike Rate Limiting &amp; HPA&lt;br&gt;• &lt;b style='color:#FFEB3B'&gt;SOP-03: Concurrency Spike + Memory Degradation&lt;/b&gt;&lt;br&gt;• SOP-04: Worker Node Partition &amp; Eviction&lt;br&gt;• SOP-05: Database Connection Exhaustion&lt;br&gt;• SOP-06: Rolling Deployment Canary Rollback&lt;br&gt;&lt;i&gt;Retriever: Cosine Similarity via BGE-Embeddings&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#283593;strokeColor=#1A237E;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="150" width="330" height="190" as="geometry"/>
        </mxCell>

        <!-- Experience Memory / Replay Buffer -->
        <mxCell id="compExpMem" value="&lt;b style='font-size:13px'&gt;🧪 EXPERIENCE MEMORY&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Replay Buffer Persistent (ChromaDB Episodic)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Menyimpan seluruh transisi masa lalu:&lt;br&gt;&lt;code&gt;Tuple: &amp;lt;State, Action, Reward, Next_State&amp;gt;&lt;/code&gt;&lt;br&gt;&lt;br&gt;• K-Nearest Episode Retrieval (k=3 episode mirip)&lt;br&gt;• Belajar dari aksi masa lalu yang sukses (&amp;gt;90)&lt;br&gt;• Menghindari aksi yang pernah gagal/rollback&lt;br&gt;• &lt;b&gt;Tidak hilang saat restart&lt;/b&gt; (berbeda dr Pure RL)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A148C;strokeColor=#311B92;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="365" width="330" height="180" as="geometry"/>
        </mxCell>

        <!-- Context Synthesizer & Prompt Assembler -->
        <mxCell id="compPromptBuilder" value="&lt;b style='font-size:13px'&gt;🧩 PROMPT CONTEXT SYNTHESIZER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Fusi Data Multidimensional Menjadi Grounded Prompt&lt;/b&gt;&lt;br&gt;&lt;br&gt;Menggabungkan:&lt;br&gt;1. State Eksak Pandas (Matrix Angka)&lt;br&gt;2. Prediksi GNN/LSTM (Konteks Sebab-Akibat)&lt;br&gt;3. SOP Terpilih dari RAG (Instruksi Prosedural)&lt;br&gt;4. Pengalaman Sukses Masa Lalu (Historical Prior)&lt;br&gt;5. Batasan Fisik Node &amp; Action Schema (Enums)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#004D40;strokeColor=#00251A;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="575" width="330" height="160" as="geometry"/>
        </mxCell>

        <!-- Arrows Zone B -->
        <mxCell id="eb1" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#1A237E;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="compRAG" target="compPromptBuilder"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb2" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A148C;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="compExpMem" target="compPromptBuilder"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb3" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#004D40;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="compPayload" target="compPromptBuilder"><mxGeometry relative="1" as="geometry"/></mxCell>


        <!-- ==================== ZONE C: REASONING CORE (POLICY NETWORK) ==================== -->
        <mxCell id="zoneCBg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=2;opacity=40;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="850" y="105" width="410" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="zoneCLabel" value="&lt;b style='font-size:13px;color:#880E4F;'&gt;ZONE C: POLICY NETWORK &amp; ACTION SCHEMA (RL: POLICY)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="865" y="115" width="380" height="25" as="geometry"/>
        </mxCell>

        <!-- Gemini Flash Box -->
        <mxCell id="compGemini" value="&lt;b style='font-size:14px'&gt;🤖 GOOGLE GEMINI 2.0 FLASH&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;= POLICY NETWORK (π(a|s)) dalam RL&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Hyperparameter:&lt;/b&gt; Temperature = 0.1 (Deterministik)&lt;br&gt;• Latensi Inferensi Super Cepat (~600ms)&lt;br&gt;• &lt;b&gt;System Prompt Injection:&lt;/b&gt; Peran SRE Otonom&lt;br&gt;• &lt;b&gt;Multi-Step CoT:&lt;/b&gt; Merumuskan tahapan aksi logis&lt;br&gt;• &lt;b&gt;Pydantic Type-Lock:&lt;/b&gt; Memaksa output berupa JSON valid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AD1457;strokeColor=#880E4F;strokeWidth=2.5;fontSize=11;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="150" width="370" height="150" as="geometry"/>
        </mxCell>

        <!-- Fallback Engine -->
        <mxCell id="compFallback" value="&lt;b&gt;⚙️ Rule-Based Fallback Engine (Safety Net)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Aktif otomatis jika API Gemini timeout / quota limit habis.&lt;br&gt;Eksekusi static heuristic lookup table langsung dari SOP.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#880E4F;strokeColor=#4A148C;strokeWidth=1.5;fontSize=10;fontColor=#FFF;arcSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="320" width="370" height="55" as="geometry"/>
        </mxCell>

        <!-- 7 Locked Actions -->
        <mxCell id="compActionSpace" value="&lt;b style='font-size:13px'&gt;🔒 7 AKSI TERKUNCI (PYDANTIC ENUM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;= ACTION SPACE (A) dalam RL — Strict Anti-Halusinasi&lt;/b&gt;&lt;br&gt;&lt;br&gt;AI tidak bisa mengeksekusi perintah di luar 7 aksi ini:&lt;br&gt;1. &lt;b&gt;no_op&lt;/b&gt; — Metrik fluktuatif aman, tidak butuh tindakan&lt;br&gt;2. &lt;b&gt;restart_pod&lt;/b&gt; — Rolling restart pod bocor / memory leak&lt;br&gt;3. &lt;b&gt;scale_out&lt;/b&gt; — Tambah replika pod untuk membagi load spike&lt;br&gt;4. &lt;b&gt;scale_in&lt;/b&gt; — Kurangi replika saat traffic kembali normal&lt;br&gt;5. &lt;b&gt;rate_limit&lt;/b&gt; — Terapkan token bucket jika cluster overload&lt;br&gt;6. &lt;b&gt;migrate&lt;/b&gt; — Pindahkan pod dari worker rusak ke worker sehat&lt;br&gt;7. &lt;b&gt;escalate&lt;/b&gt; — Panggil tim SRE manusia jika risiko &gt; ambang batas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C2185B;strokeColor=#880E4F;strokeWidth=2;fontSize=10;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="400" width="370" height="210" as="geometry"/>
        </mxCell>

        <!-- Output JSON Structure -->
        <mxCell id="compOutputJSON" value="&lt;b style='font-size:12px'&gt;📄 Pydantic Validated JSON Output&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;font-family:monospace'&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;thought_process&quot;: &quot;Scale 2-&gt;5 lalu restart...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;confidence_score&quot;: 0.94,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;action_plan&quot;: [{&quot;step&quot;: 1, &quot;action&quot;: &quot;scale_out&quot;}, ...]&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474F;strokeColor=#263238;strokeWidth=1.5;fontSize=10;fontColor=#FFFFFF;arcSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="630" width="370" height="85" as="geometry"/>
        </mxCell>

        <!-- Arrows Zone C -->
        <mxCell id="ec1" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#AD1457;strokeWidth=2.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="compPromptBuilder" target="compGemini"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec2" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#C2185B;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="compGemini" target="compActionSpace"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec3" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#37474F;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="compActionSpace" target="compOutputJSON"><mxGeometry relative="1" as="geometry"/></mxCell>


        <!-- ==================== ZONE D: SAFETY GUARDRAILS & SANDBOX ==================== -->
        <mxCell id="zoneDBg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=2;opacity=40;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1290" y="105" width="400" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="zoneDLabel" value="&lt;b style='font-size:13px;color:#E65100;'&gt;ZONE D: 5-LAYER GUARDRAILS &amp; OPTIMIZER&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1305" y="115" width="370" height="25" as="geometry"/>
        </mxCell>

        <!-- Guardrails Box -->
        <mxCell id="compGuardrails" value="&lt;b style='font-size:13px'&gt;🛡️ 5-LAYER SAFETY GUARDRAILS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Filter Pertahanan Sebelum Sentuh Cluster Produksi&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Cooldown Lock:&lt;/b&gt; Cegah modifikasi service yg sama &amp;lt;10 menit&lt;br&gt;2. &lt;b&gt;Confidence Gate:&lt;/b&gt; Wajib Confidence &amp;gt; 0.80 (jika &amp;lt;0.80 reject)&lt;br&gt;3. &lt;b&gt;Critical Pod Blacklist:&lt;/b&gt; Dilarang keras restart kube-system, etcd&lt;br&gt;4. &lt;b&gt;Circuit Breaker:&lt;/b&gt; Maksimal 3x aksi berturut dlm 15 menit&lt;br&gt;5. &lt;b&gt;Blast Radius Limiter:&lt;/b&gt; Max scale 10 replika per service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFA000;strokeColor=#FF6F00;strokeWidth=2;fontSize=11;fontColor=#333;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="150" width="360" height="175" as="geometry"/>
        </mxCell>

        <!-- ML Precision Optimizer -->
        <mxCell id="compMLOpt" value="&lt;b style='font-size:13px'&gt;🎯 ML PRECISION OPTIMIZER (XGBoost)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Solusi Masalah RL: Optimasi Angka Presisi&lt;/b&gt;&lt;br&gt;&lt;br&gt;Jika Gemini memutuskan aksi &lt;b&gt;scale_out&lt;/b&gt;:&lt;br&gt;• XGBoost Regressor menghitung persis formula:&lt;br&gt;  &lt;i&gt;Target Replicas = f(RPS_current, P95_target, CPU_headroom)&lt;/i&gt;&lt;br&gt;• Menghasilkan angka presisi: &lt;b&gt;Tepat 5 Pod&lt;/b&gt; (bukan tebak 3 / 8)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE082;strokeColor=#FFB300;strokeWidth=2;fontSize=11;fontColor=#333;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="350" width="360" height="140" as="geometry"/>
        </mxCell>

        <!-- Sandbox Dry-Run -->
