<mxfile host="app.diagrams.net" modified="2026-09-21T08:45:00.000Z" agent="XFSCI-Simple-Loop" version="24.7.17">
  <diagram id="xfsci-simple-loop" name="XFSCI — Alur Kerja Sederhana (Closed-Loop)">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== HEADER TITLE ==================== -->
        <mxCell id="titleBox" value="&lt;b style='font-size:18px;color:#1A237E;'&gt;🔄 XFSCI: Alur Kerja Tertutup (Closed-Loop Self-Healing Workflow)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#555;'&gt;Siklus Otonom: Observasi (Monitoring) → Diagnosis (GNN+LSTM) → Penalaran (AI Agent) → Validasi (Guardrails) → Aksi (Kubectl) → Akuntabilitas (XAI, FL, Dashboard)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=1.5;align=center;verticalAlign=middle;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1380" height="60" as="geometry"/>
        </mxCell>

        <!-- ==================== ROW 1: SENSING & COGNITION (LEFT TO RIGHT) ==================== -->

        <!-- BOX 0: Cluster VMs (The Source) -->
        <mxCell id="boxCluster" value="&lt;b style='font-size:14px'&gt;🖥️ Cluster VMs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#ECEFF1'&gt;1 Master + 3 Worker Nodes&lt;br&gt;Jakarta · Bandung · Surabaya&lt;br&gt;&lt;i&gt;(Workloads &amp; Microservices)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#37474F;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;arcSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="220" height="110" as="geometry"/>
        </mxCell>

        <!-- BOX 1: Step 1 - Monitoring -->
        <mxCell id="boxMon" value="&lt;b style='font-size:14px'&gt;① Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#E0F2F1'&gt;&lt;b&gt;Prometheus · Loki · OpenTel&lt;/b&gt;&lt;br&gt;Scrape metrik tiap 5 detik:&lt;br&gt;CPU, RAM, RPS, Latency, Error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00897B;strokeColor=#004D40;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;arcSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="220" height="110" as="geometry"/>
        </mxCell>

        <!-- BOX 2: Step 2 - GNN + LSTM -->
        <mxCell id="boxAI" value="&lt;b style='font-size:14px'&gt;② Analisis AI Spesialis&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#EDE7F6'&gt;&lt;b&gt;GNN (PyG) + LSTM&lt;/b&gt;&lt;br&gt;• Root-cause &amp; blast radius&lt;br&gt;• Prediksi failure 15 mnt kedepan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E35B1;strokeColor=#4527A0;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;arcSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="130" width="230" height="110" as="geometry"/>
        </mxCell>

        <!-- BOX 3: Step 3 - AI Agent -->
        <mxCell id="boxAgent" value="&lt;b style='font-size:14px'&gt;③ AI AGENT (Otak Eksekutif)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#FFF3E0'&gt;&lt;b&gt;Gemini 2.0 Flash + Pandas + RAG&lt;/b&gt;&lt;br&gt;• Pandas: Kalkulasi State matematis&lt;br&gt;• RAG: 6 SOP industri (ChromaDB)&lt;br&gt;• Gemini: Penalaran rencana aksi (JSON)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BF360C;strokeColor=#870000;strokeWidth=2.5;fontSize=12;fontColor=#FFFFFF;arcSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="125" width="270" height="120" as="geometry"/>
        </mxCell>

        <!-- ==================== ARROWS ROW 1 ==================== -->
        <!-- Cluster -> Monitoring -->
        <mxCell id="e1" value="Telemetri Mentah&lt;br&gt;(CPU, RAM, RPS)" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#00897B;strokeWidth=2.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#004D40;fontStyle=1;" edge="1" parent="1" source="boxCluster" target="boxMon">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Monitoring -> GNN+LSTM -->
        <mxCell id="e2" value="Timeseries &amp;&lt;br&gt;Log Stream" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5E35B1;strokeWidth=2.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#4527A0;fontStyle=1;" edge="1" parent="1" source="boxMon" target="boxAI">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- GNN+LSTM -> AI Agent -->
        <mxCell id="e3" value="Risk Score &amp;&lt;br&gt;Root Cause" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#BF360C;strokeWidth=2.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#BF360C;fontStyle=1;" edge="1" parent="1" source="boxAI" target="boxAgent">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== ROW 2: VALIDATION & ACTUATION (RIGHT TO LEFT) ==================== -->

        <!-- Guardrails (Under AI Agent) -->
        <mxCell id="boxGuard" value="&lt;b style='font-size:13px'&gt;🛡️ Guardrails &amp; Sandbox&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#333'&gt;5 Layer Proteksi Keamanan:&lt;br&gt;Cooldown · Confidence Gate (&amp;gt;0.8)&lt;br&gt;Circuit Breaker · Pydantic Schema&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=2;fontSize=11;fontColor=#333333;arcSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="320" width="270" height="95" as="geometry"/>
        </mxCell>

        <!-- AI Agent -> Guardrails -->
        <mxCell id="e4" value="Action Plan (JSON)&lt;br&gt;7 Aksi Terkunci" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#FFA000;strokeWidth=2.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#E65100;fontStyle=1;" edge="1" parent="1" source="boxAgent" target="boxGuard">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 4 - Self-Healing Actuator -->
        <mxCell id="boxAct" value="&lt;b style='font-size:14px'&gt;④ Self-Healing Actuator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#E0F7FA'&gt;&lt;b&gt;Kubernetes Controller / Kubectl&lt;/b&gt;&lt;br&gt;• Multi-step Execution&lt;br&gt;• Scale, Restart, Migrate, Cordon&lt;br&gt;• Auto-Rollback jika gagal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00838F;strokeColor=#006064;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;arcSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="320" width="240" height="95" as="geometry"/>
        </mxCell>

        <!-- Guardrails -> Self-Healing -->
        <mxCell id="e5" value="✅ Lolos Validasi&lt;br&gt;(Approved)" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#00838F;strokeWidth=2.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#006064;fontStyle=1;" edge="1" parent="1" source="boxGuard" target="boxAct">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Box Cluster Pulih (Healed State) -->
        <mxCell id="boxRecovered" value="&lt;b style='font-size:14px'&gt;💚 Cluster Pulih / Normal&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#E8F5E9'&gt;• Latensi normal (&amp;lt;100ms)&lt;br&gt;• Error rate 0% · Pods Ready&lt;br&gt;• SLA Bisnis Terselamatkan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;strokeWidth=2.5;fontSize=12;fontColor=#FFFFFF;arcSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="320" width="220" height="95" as="geometry"/>
        </mxCell>

        <!-- Self-Healing -> Cluster Pulih -->
        <mxCell id="e6" value="Eksekusi Nyata di K8s&lt;br&gt;(Rolling update / Scale)" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#1B5E20;fontStyle=1;" edge="1" parent="1" source="boxAct" target="boxRecovered">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Cluster Pulih -> Loop Back to Cluster VMs -->
        <mxCell id="eLoop" value="🔄 Umpan Balik (Feedback Loop)&lt;br&gt;Cluster kembali stabil" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2.5;dashed=1;dashPattern=6 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;curved=1;fontSize=10;fontColor=#1B5E20;fontStyle=1;" edge="1" parent="1" source="boxRecovered" target="boxCluster">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="170" y="367"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== ROW 3: TRANSPARENCY, LEARNING & HUMAN INTERACTION ==================== -->
        <mxCell id="bgRow3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CFD8DC;strokeWidth=1.5;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="1380" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="labelRow3" value="&lt;b style='color:#37474F'&gt;📊 LAYER TRANSPARANSI, PEMBELAJARAN DISTRIBUSI &amp; KONTROL OPERATOR&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="478" width="600" height="20" as="geometry"/>
        </mxCell>

        <!-- Step 5: XAI -->
        <mxCell id="boxXAI" value="&lt;b style='font-size:13px'&gt;⑤ Explainable AI (XAI)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#EDE7F6'&gt;&lt;b&gt;SHAP / LIME + Thought Process&lt;/b&gt;&lt;br&gt;Transparansi ke tim SRE mengapa&lt;br&gt;aksi dipilih &amp; kontributor metrik&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B1FA2;strokeColor=#4A148C;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="510" width="280" height="95" as="geometry"/>
        </mxCell>

        <!-- Step 6: Federated Learning -->
        <mxCell id="boxFL" value="&lt;b style='font-size:13px'&gt;⑥ Federated Learning (FL)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#E0F2F1'&gt;&lt;b&gt;Flower Framework + KRUM&lt;/b&gt;&lt;br&gt;Latih model prediksi lokal antar-region;&lt;br&gt;Privasi data aman &amp; anti-poisoning&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00695C;strokeColor=#004D40;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="510" width="300" height="95" as="geometry"/>
        </mxCell>

        <!-- Step 7: Dashboard -->
        <mxCell id="boxDash" value="&lt;b style='font-size:13px'&gt;⑦ Dashboard &amp; HITL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#FFEBEE'&gt;&lt;b&gt;Next.js + FastAPI&lt;/b&gt;&lt;br&gt;Visualisasi live real-time + Panel&lt;br&gt;Approval Human-in-the-Loop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=#B71C1C;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="510" width="300" height="95" as="geometry"/>
        </mxCell>

        <!-- Experience Memory Storage -->
        <mxCell id="boxExp" value="&lt;b style='font-size:13px'&gt;💾 Experience Memory&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#E8EAF6'&gt;&lt;b&gt;ChromaDB (Replay Buffer)&lt;/b&gt;&lt;br&gt;Menyimpan transisi (S, A, R, S')&lt;br&gt;untuk pembelajaran masa depan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#283593;strokeColor=#1A237E;strokeWidth=2;fontSize=11;fontColor=#FFFFFF;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="510" width="280" height="95" as="geometry"/>
        </mxCell>

        <!-- Connections from Recovery to Row 3 -->
        <mxCell id="eRecoverToXAI" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7B1FA2;strokeWidth=1.5;dashed=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="boxRecovered" target="boxXAI">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eRecoverToFL" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#00695C;strokeWidth=1.5;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="boxRecovered" target="boxFL">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eActToDash" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="boxAct" target="boxDash">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eGuardToExp" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#283593;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="boxGuard" target="boxExp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== BOTTOM NOTE / CHEAT SHEET ==================== -->
        <mxCell id="noteBox" value="&lt;b&gt;💡 Cara Menjelaskan ke Dosen dalam 30 Detik:&lt;/b&gt;&lt;br&gt;&lt;font style='color:#444;'&gt;&quot;Sistem bekerja sebagai &lt;b&gt;Closed-Loop Control&lt;/b&gt;: Cluster dimonitor oleh &lt;b&gt;Prometheus ①&lt;/b&gt; → jika ada gejala abnormal, &lt;b&gt;GNN &amp; LSTM ②&lt;/b&gt; mendeteksi akar masalah dan meramal kegagalan → &lt;b&gt;AI Agent (Gemini + Pandas + RAG) ③&lt;/b&gt; bernalar menentukan strategi terbaik → divalidasi oleh &lt;b&gt;Guardrails&lt;/b&gt; agar aman → dieksekusi oleh &lt;b&gt;Actuator ④&lt;/b&gt; → Cluster kembali sehat 💚. Seluruh histori dan penjelasannya disajikan via &lt;b&gt;XAI ⑤&lt;/b&gt;, &lt;b&gt;FL ⑥&lt;/b&gt;, dan &lt;b&gt;Dashboard ⑦&lt;/b&gt;.&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FFF59D;strokeWidth=1.5;align=left;verticalAlign=middle;fontSize=11;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1380" height="70" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
