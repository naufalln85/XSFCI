<mxfile host="app.diagrams.net" modified="2026-07-18T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="xfsci-simple" name="XFSCI Simple Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;XFSCI - Simple Multi-Cluster Self-Healing Architecture&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="310" y="25" width="980" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Four simple steps: collect locally - learn together - decide centrally - heal locally" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="880" height="30" as="geometry"/></mxCell>

        <mxCell id="localZone" value="&lt;b&gt;1. LOCAL SITES / CLUSTERS&lt;/b&gt;&lt;br&gt;Raw metrics and logs remain in each site" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#EFF6FF;swimlaneFillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="420" height="610" as="geometry"/></mxCell>

        <mxCell id="siteA" value="&lt;b&gt;Cluster A - Normal&lt;/b&gt;&lt;br&gt;Stable workload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;fontSize=13;fontColor=#1E3A8A;" vertex="1" parent="localZone"><mxGeometry x="35" y="75" width="350" height="110" as="geometry"/></mxCell>
        <mxCell id="siteB" value="&lt;b&gt;Cluster B - Load Test&lt;/b&gt;&lt;br&gt;Traffic spike and latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;fontSize=13;fontColor=#1E3A8A;" vertex="1" parent="localZone"><mxGeometry x="35" y="245" width="350" height="110" as="geometry"/></mxCell>
        <mxCell id="siteC" value="&lt;b&gt;Cluster C - Security Test&lt;/b&gt;&lt;br&gt;Fault injection and Byzantine client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;fontSize=13;fontColor=#1E3A8A;" vertex="1" parent="localZone"><mxGeometry x="35" y="415" width="350" height="110" as="geometry"/></mxCell>

        <mxCell id="siteNote" value="Each cluster contains: workload + local monitoring + local agent&lt;br&gt;Platform can be Kubernetes, OpenStack, or VM." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="localZone"><mxGeometry x="30" y="545" width="360" height="40" as="geometry"/></mxCell>

        <mxCell id="federatedZone" value="&lt;b&gt;2. FEDERATED CONTROL PLANE&lt;/b&gt;&lt;br&gt;One lightweight central server" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#F0FDFA;swimlaneFillColor=#0F766E;strokeColor=#0F766E;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="255" width="350" height="305" as="geometry"/></mxCell>
        <mxCell id="coordinator" value="&lt;b&gt;Federated Coordinator&lt;/b&gt;&lt;br&gt;Receives model updates via HTTPS&lt;br&gt;&lt;font color=&quot;#0F766E&quot;&gt;No raw logs or metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14B8A6;strokeWidth=2;fontSize=13;fontColor=#134E4A;" vertex="1" parent="federatedZone"><mxGeometry x="35" y="75" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="robust" value="&lt;b&gt;Robust Aggregation&lt;/b&gt;&lt;br&gt;Krum / Median / LASA filters bad updates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontColor=#78350F;" vertex="1" parent="federatedZone"><mxGeometry x="35" y="190" width="280" height="62" as="geometry"/></mxCell>

        <mxCell id="decisionZone" value="&lt;b&gt;3. INTELLIGENT DECISION AND HEALING&lt;/b&gt;" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#FFF7ED;swimlaneFillColor=#EA580C;strokeColor=#EA580C;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1010" y="190" width="390" height="395" as="geometry"/></mxCell>
        <mxCell id="prediction" value="&lt;b&gt;Failure Prediction&lt;/b&gt;&lt;br&gt;Detects risk: normal / warning / critical" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;strokeWidth=2;fontSize=13;fontColor=#4C1D95;" vertex="1" parent="decisionZone"><mxGeometry x="45" y="70" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="rl" value="&lt;b&gt;RL Decision Agent&lt;/b&gt;&lt;br&gt;Chooses: restart, scale, rate-limit, or no-op" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FB923C;strokeWidth=2;fontSize=13;fontColor=#7C2D12;" vertex="1" parent="decisionZone"><mxGeometry x="45" y="165" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="healing" value="&lt;b&gt;Healing Action&lt;/b&gt;&lt;br&gt;Local agent executes approved action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontColor=#7F1D1D;" vertex="1" parent="decisionZone"><mxGeometry x="45" y="260" width="300" height="62" as="geometry"/></mxCell>

        <mxCell id="dashboard" value="&lt;b&gt;4. X-FedHealing Dash&lt;/b&gt;&lt;br&gt;Cluster health, risk score, selected action, XAI explanation, and healing history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontColor=#713F12;" vertex="1" parent="1"><mxGeometry x="1020" y="670" width="370" height="100" as="geometry"/></mxCell>

        <mxCell id="step1" value="A. Train locally" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="475" y="175" width="130" height="25" as="geometry"/></mxCell>
        <mxCell id="step2" value="B. Aggregate safely" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#0F766E;" vertex="1" parent="1"><mxGeometry x="820" y="175" width="170" height="25" as="geometry"/></mxCell>
        <mxCell id="step3" value="C. Send healing policy" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="705" y="610" width="190" height="25" as="geometry"/></mxCell>

        <mxCell id="eA" value="model update only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#0D9488;fontSize=11;fontColor=#115E59;" edge="1" parent="1" source="siteA" target="coordinator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#0D9488;" edge="1" parent="1" source="siteB" target="coordinator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#0D9488;" edge="1" parent="1" source="siteC" target="coordinator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eCR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D97706;strokeWidth=2;" edge="1" parent="federatedZone" source="coordinator" target="robust"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRP" value="global model" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;fontColor=#4C1D95;" edge="1" parent="1" source="robust" target="prediction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ePR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=2;" edge="1" parent="decisionZone" source="prediction" target="rl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRH" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#DC2626;strokeWidth=2;" edge="1" parent="decisionZone" source="rl" target="healing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eHA" value="approved action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#EA580C;fontSize=11;fontColor=#9A3412;" edge="1" parent="1" source="healing" target="siteA"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eHB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#EA580C;" edge="1" parent="1" source="healing" target="siteB"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eHC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#EA580C;" edge="1" parent="1" source="healing" target="siteC"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eDash" value="status, risk, action, explanation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#CA8A04;strokeWidth=2;fontSize=11;fontColor=#713F12;" edge="1" parent="1" source="healing" target="dashboard"><mxGeometry relative="1" as="geometry"/></mxCell>
