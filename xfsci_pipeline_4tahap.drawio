          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CLOSED LOOP FEEDBACK ARROW (ROLLBACK / VERIFICATION) -->
        <mxCell id="feedbackLoop" value="Verifikasi Gagal ➔ Auto-Rollback ke Status Awal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#DC2626;strokeWidth=2;strokeFactor=1;dashed=1;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=11;fontColor=#DC2626;" edge="1" parent="1" source="card4" target="card3">
          <mxGeometry x="-0.02" y="15" relative="1" as="geometry">
