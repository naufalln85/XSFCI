        <!-- CARD 4: AKTUASI -->
        <mxCell id="card4" value="&lt;div style=&quot;background-color:#047857; color:#FFFFFF; padding:10px; border-radius:8px 8px 0 0; font-family:Helvetica; font-size:14px; font-weight:bold; text-align:center;&quot;&gt;4. AKTUASI&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:normal; opacity:0.9;&quot;&gt;Closed-Loop Kubernetes&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:12px; font-family:Helvetica; font-size:12px; color:#0F172A; line-height:1.6; text-align:left;&quot;&gt;&lt;b style=&quot;color:#047857;&quot;&gt;•&lt;/b&gt; Precision Optimizer ML&lt;br&gt;&lt;b style=&quot;color:#047857;&quot;&gt;•&lt;/b&gt; API Patch &amp;amp; Rollout Rolling&lt;br&gt;&lt;b style=&quot;color:#047857;&quot;&gt;•&lt;/b&gt; Post-Action Health Check 30s&lt;br&gt;&lt;b style=&quot;color:#047857;&quot;&gt;•&lt;/b&gt; Automated Safe Rollback&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;shadow=1;overflow=hidden;" vertex="1" parent="1">
