        <!-- BOTTOM PRINCIPLE BANNER -->
        <mxCell id="banner" value="&lt;div style=&quot;font-family:Helvetica; font-size:12px; color:#1E293B; text-align:center;&quot;&gt;&lt;b style=&quot;color:#DC2626;&quot;&gt;Prinsip Kunci (Trustworthy SRE):&lt;/b&gt; Kemampuan sistem menolak bertindak (&lt;i&gt;Safe Abstention&lt;/i&gt;) saat bukti tidak cukup sama bernilainya dengan mengeksekusi perbaikan.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;shadow=0;" vertex="1" parent="1">
