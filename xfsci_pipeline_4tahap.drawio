  <diagram id="xfsci-4stage-pipeline" name="XFSCI 4-Stage Closed-Loop Pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE HEADER -->
        <mxCell id="title" value="&lt;div style=&quot;font-family:Helvetica; text-align:center;&quot;&gt;&lt;b style=&quot;font-size:18px; color:#0F172A;&quot;&gt;XFSCI: Level-4 Autonomous SRE Closed-Loop Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#475569;&quot;&gt;Arsitektur Dual-Mechanism: Otak Penalaran (Agentic AI) vs. Rem Pengendali Risiko (Safety Gate &amp;amp; Sandbox)&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="235" y="80" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- CARD 1: PERSEPSI -->
        <mxCell id="card1" value="&lt;div style=&quot;background-color:#1D4ED8; color:#FFFFFF; padding:10px; border-radius:8px 8px 0 0; font-family:Helvetica; font-size:14px; font-weight:bold; text-align:center;&quot;&gt;1. PERSEPSI&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:normal; opacity:0.9;&quot;&gt;DualHead GATv2 GNN&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:12px; font-family:Helvetica; font-size:12px; color:#0F172A; line-height:1.6; text-align:left;&quot;&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;•&lt;/b&gt; 23 Fitur Telemetri ML&lt;br&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;•&lt;/b&gt; Topologi Graf Mikroservis&lt;br&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;•&lt;/b&gt; Deteksi Akar Masalah (RCA)&lt;br&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;•&lt;/b&gt; Waktu Inferensi &amp;lt; 5ms&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=2;shadow=1;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="230" height="190" as="geometry" />
        </mxCell>

        <!-- CARD 2: KOGNISI (OTAK) -->
        <mxCell id="card2" value="&lt;div style=&quot;background-color:#6D28D9; color:#FFFFFF; padding:10px; border-radius:8px 8px 0 0; font-family:Helvetica; font-size:14px; font-weight:bold; text-align:center;&quot;&gt;2. KOGNISI (OTAK)&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:normal; opacity:0.9;&quot;&gt;Multi-Model Agentic AI&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:12px; font-family:Helvetica; font-size:12px; color:#0F172A; line-height:1.6; text-align:left;&quot;&gt;&lt;b style=&quot;color:#6D28D9;&quot;&gt;•&lt;/b&gt; Claude Opus Thinking (Deep)&lt;br&gt;&lt;b style=&quot;color:#6D28D9;&quot;&gt;•&lt;/b&gt; Gemini 3.8 Flash (Failover)&lt;br&gt;&lt;b style=&quot;color:#6D28D9;&quot;&gt;•&lt;/b&gt; RAG SRE Runbooks (SOP)&lt;br&gt;&lt;b style=&quot;color:#6D28D9;&quot;&gt;•&lt;/b&gt; Penalaran Berbasis Bukti Riil&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=2;shadow=1;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="230" height="190" as="geometry" />
        </mxCell>

        <!-- CARD 3: SAFETY GATE (REM) -->
        <mxCell id="card3" value="&lt;div style=&quot;background-color:#C2410C; color:#FFFFFF; padding:10px; border-radius:8px 8px 0 0; font-family:Helvetica; font-size:14px; font-weight:bold; text-align:center;&quot;&gt;3. SAFETY GATE (REM)&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:normal; opacity:0.9;&quot;&gt;Sandbox &amp;amp; Risk Guardrail&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:12px; font-family:Helvetica; font-size:12px; color:#0F172A; line-height:1.6; text-align:left;&quot;&gt;&lt;b style=&quot;color:#C2410C;&quot;&gt;•&lt;/b&gt; Matriks: Confidence x Risk&lt;br&gt;&lt;b style=&quot;color:#C2410C;&quot;&gt;•&lt;/b&gt; Uji Kloning xfsci-sandbox&lt;br&gt;&lt;b style=&quot;color:#C2410C;&quot;&gt;•&lt;/b&gt; Safe Inaction (no_op)&lt;br&gt;&lt;b style=&quot;color:#C2410C;&quot;&gt;•&lt;/b&gt; Human Escalation (escalate)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=2;shadow=1;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="600" y="180" width="230" height="190" as="geometry" />
